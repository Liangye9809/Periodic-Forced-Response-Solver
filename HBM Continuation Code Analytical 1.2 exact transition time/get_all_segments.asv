function S =  get_all_segments(flag, xct, dxct, kt, kn, mu, Ft, H)
    Nx = size(flag, 2);
    S = {};
    for i = 1:Nx
        flagT1(:, 1) = flag(1, i, :);
        flagT2(:, 1) = flag(2, i, :);
        xt1 = xct(:, 3 * i - 2);
        xt2 = xct(:, 3 * i - 1);
         xn = xct(:, 3 * i);
        dxt1 = dxct
        S{1, i} = get_integral_time_position(flagT1, xt, xn, dxt, dxn, kt, kn, mu, ft, H);
        S{2, i} = get_integral_time_position(flagT1, xt, xn, dxt, dxn, kt, kn, mu, ft, H);
    end
end